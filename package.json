{
  "name": "runbook-ai-publisher",
  "version": "1.0.0",
  "description": "Node.js backend for uploading documents, converting them into Markdown runbooks using AI, and publishing them to the ubuntu-runbook GitHub repository.",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/app.js"
  },
  "keywords": [
    "runbook",
    "knowledge-base",
    "markdown",
    "ai",
    "github",
    "mkdocs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "better-sqlite3": "^12.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "openai": "^6.0.0",
    "slugify": "^1.6.6",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}